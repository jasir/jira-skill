#!/usr/bin/env bash
set -euo pipefail

CREDS="${HOME}/.config/jira/credentials"
if [[ ! -f "$CREDS" ]]; then
  echo "Error: missing credentials file: $CREDS"
  echo ""
  echo "Create it with:"
  echo "  mkdir -p ~/.config/jira"
  echo "  cat > ~/.config/jira/credentials << 'EOF'"
  echo "  JIRA_URL=https://your-instance.atlassian.net"
  echo "  JIRA_USER=your@email.com"
  echo "  JIRA_TOKEN=ATATT3x..."
  echo "  EOF"
  echo "  chmod 600 ~/.config/jira/credentials"
  exit 1
fi
# shellcheck source=/dev/null
source "$CREDS"

BASE_URL="${JIRA_URL}/rest/api/3"
AUTH="${JIRA_USER}:${JIRA_TOKEN}"
ISSUE_KEY_RE='[A-Z][A-Z0-9]+-[0-9]+'
MIN_CHANGELOG_FETCH=100
SYSTEM_CHANGELOG_FIELDS_JSON='["IssueParentAssociation","Rank","WorklogId","Attachment"]'

JSON=false
if [[ "${1:-}" == "--json" ]]; then
  JSON=true
  shift
fi

cmd="${1:-help}"
shift || true

# Recursive ADF (Atlassian Document Format) → plain text.
# Handles paragraphs, lists, headings, blockquotes, code blocks, hard breaks.
_ADF_JQ='
def t:
  if type == "object" then
    if .type == "text" then (.text // "")
    elif .type == "inlineCard" then
      (.attrs.url // "") as $u
      | (try ($u | capture($issue_re_capture).k) catch "") as $candidate
      | if ($candidate | test($issue_re)) then "[" + $candidate + "]" else "[link]" end
    elif .type == "hardBreak" then "\n"
    elif .type == "listItem" then "- " + ([(.content // [])[] | t] | join("")) + "\n"
    elif .type == "paragraph" then ([(.content // [])[] | t] | join("")) + "\n"
    elif .type == "heading" then "\n" + ([(.content // [])[] | t] | join("")) + "\n"
    elif .type == "blockquote" then "> " + ([(.content // [])[] | t] | join("")) + "\n"
    elif .type == "codeBlock" then "\n```\n" + ([(.content // [])[] | t] | join("")) + "\n```\n"
    else ([(.content // [])[] | t] | join(""))
    end
  else "" end;
if . == null then "" else t end
'

_adf2text() {
  jq -r --arg issue_re "^${ISSUE_KEY_RE}$" --arg issue_re_capture "/browse/(?<k>${ISSUE_KEY_RE})" "$_ADF_JQ"
}

_fmt_issue() {
  jq -r '"[\(.fields.status.name)] \(.key): \(.fields.summary)\nAssignee: \(.fields.assignee.displayName // "Unassigned")\nPriority:  \(.fields.priority.name)\nURL:       '"${JIRA_URL}"'/browse/\(.key)"'
}

_fmt_list() {
  jq -r '.issues[] | "[" + .fields.status.name + "] " + .key + ": " + .fields.summary'
}

_fmt_comments() {
  local data="$1"
  local cnt
  cnt=$(echo "$data" | jq '.comments | length')
  if [[ "$cnt" == "0" ]]; then
    echo "(no comments)"
    return
  fi
  echo "$data" | jq -c '.comments[]' | while IFS= read -r c; do
    local author created id
    author=$(echo "$c" | jq -r '.author.displayName')
    created=$(echo "$c" | jq -r '.created | .[0:16] | sub("T"; " ")')
    id=$(echo "$c" | jq -r '.id')
    echo "── $author — $created (id: $id)"
    echo "$c" | jq '.body' | _adf2text
    echo ""
  done
}

_build_comment_nodes() {
  local text="$1"
  local remaining="$text"
  local nodes='[]'
  local idx=1

  while [[ "$remaining" =~ \[\[(${ISSUE_KEY_RE})\]\] ]]; do
    local marker key prefix
    marker="${BASH_REMATCH[0]}"
    key="${BASH_REMATCH[1]}"
    prefix="${remaining%%"$marker"*}"

    if [[ -n "$prefix" ]]; then
      nodes=$(echo "$nodes" | jq -c --arg t "$prefix" '. + [{"type":"text","text":$t}]')
    fi
    nodes=$(echo "$nodes" | jq -c --arg u "${JIRA_URL}/browse/${key}" --arg lid "link-${key}-${idx}" \
      '. + [{"type":"inlineCard","attrs":{"url":$u,"localId":$lid}}]')

    remaining="${remaining#*"$marker"}"
    idx=$((idx + 1))
  done

  if [[ -n "$remaining" ]]; then
    nodes=$(echo "$nodes" | jq -c --arg t "$remaining" '. + [{"type":"text","text":$t}]')
  fi

  echo "$nodes"
}

_fmt_changelog() {
  local data="$1"
  local limit="$2"
  local skip_system="$3"
  local skip_json="false"
  if [[ "$skip_system" == "true" ]]; then
    skip_json="true"
  fi

  local out
  out=$(echo "$data" | jq -r --argjson n "$limit" --argjson skip "$skip_json" \
    --argjson system_fields "$SYSTEM_CHANGELOG_FIELDS_JSON" '
    def system_fields: $system_fields;
    def normalize(v): if v == null or v == "" then "(empty)" else (v|tostring) end;
    def latest($n):
      sort_by(.created)
      | if length <= $n then . else .[(length-$n):] end;
    [(.values // [])[]]
    | latest($n)
    | map(
        . as $h
        | ($h.items // []
          | map(select((not $skip) or ((system_fields | index(.field)) == null)))) as $items
        | if ($items | length) == 0 then empty
          else
            (($h.created[0:16] | sub("T"; " ")) + " — " + ($h.author.displayName // "Unknown")) + "\n" +
            ($items
              | map("  " + (.field // "field") + ": " + normalize(.fromString // .from) + " → " + normalize(.toString // .to))
              | join("\n"))
          end
      )
    | if length == 0 then "(no changelog entries)" else join("\n\n") end
  ')
  echo "$out"
}

_fetch_changelog_window() {
  local issue="$1"
  local limit="$2"
  local effective_limit="$limit"
  if (( effective_limit < MIN_CHANGELOG_FETCH )); then effective_limit="$MIN_CHANGELOG_FETCH"; fi
  _curl -u "$AUTH" -H "Accept: application/json" \
    "$BASE_URL/issue/$issue/changelog?maxResults=$effective_limit"
}

_curl() {
  local response http_code
  response=$(curl -s -w "\n__HTTP_CODE__:%{http_code}" "$@")
  http_code=$(echo "$response" | grep -o '__HTTP_CODE__:[0-9]*' | cut -d: -f2)
  body=$(echo "$response" | sed '$d')
  if [[ "$http_code" == "401" ]]; then
    echo "Error: unauthorized (401) - token expired? Update ~/.config/jira/credentials" >&2
    exit 1
  elif [[ "$http_code" == "404" ]]; then
    echo "Error: not found (404) - check issue key, project access, or token validity (JIRA returns 404 for auth errors too)" >&2
    exit 1
  elif [[ "$http_code" -ge 400 ]]; then
    echo "Error: HTTP $http_code" >&2
    echo "$body" | jq -r '.errorMessages[]?, (.errors // {} | to_entries[] | .key + ": " + .value)' 2>/dev/null >&2
    exit 1
  fi
  echo "$body"
}

case "$cmd" in
  get)
    issue="${1:?Usage: jira get <ISSUE-KEY> [-f field1,field2,...]}"
    shift
    qs=""
    if [[ "${1:-}" == "-f" || "${1:-}" == "--fields" ]]; then
      qs="?fields=${2:?Missing field list after $1}"
      shift 2
    fi
    r=$(_curl -u "$AUTH" -H "Accept: application/json" "$BASE_URL/issue/$issue$qs")
    if $JSON; then echo "$r" | jq .; else echo "$r" | _fmt_issue; fi
    ;;

  describe)
    issue="${1:?Usage: jira describe <ISSUE-KEY>}"
    r=$(_curl -u "$AUTH" -H "Accept: application/json" "$BASE_URL/issue/$issue?fields=description")
    if $JSON; then echo "$r" | jq '.fields.description'
    else echo "$r" | jq '.fields.description' | _adf2text; fi
    ;;

  comments)
    issue="${1:?Usage: jira comments <ISSUE-KEY>}"
    r=$(_curl -u "$AUTH" -H "Accept: application/json" "$BASE_URL/issue/$issue/comment")
    if $JSON; then echo "$r" | jq .
    else _fmt_comments "$r"; fi
    ;;

  show)
    # One API call → header + description + comments, all formatted.
    issue="${1:?Usage: jira show <ISSUE-KEY>}"
    r=$(_curl -u "$AUTH" -H "Accept: application/json" \
      "$BASE_URL/issue/$issue?fields=summary,status,assignee,priority,description,comment")
    if $JSON; then echo "$r" | jq .; exit 0; fi
    echo "$r" | _fmt_issue
    echo ""
    echo "── Description ──"
    echo "$r" | jq '.fields.description' | _adf2text
    echo "── Comments ──"
    _fmt_comments "$(echo "$r" | jq '{comments: .fields.comment.comments}')"
    ;;

  comment)
    issue="${1:?Usage: jira comment <ISSUE-KEY> <text>}"
    text="${2:?Missing comment text}"
    nodes=$(_build_comment_nodes "$text")
    body=$(jq -n --argjson nodes "$nodes" \
      '{"body":{"type":"doc","version":1,"content":[{"type":"paragraph","content":$nodes}]}}')
    _curl -u "$AUTH" \
      -H "Content-Type: application/json" \
      -H "Accept: application/json" \
      -X POST "$BASE_URL/issue/$issue/comment" \
      -d "$body" | jq -r '"Comment added (id: " + .id + ") to '"$issue"'"'
    ;;

  comment-delete)
    issue="${1:?Usage: jira comment-delete <ISSUE-KEY> <comment-id>}"
    comment_id="${2:?Missing comment id}"
    _curl -u "$AUTH" \
      -H "Accept: application/json" \
      -X DELETE "$BASE_URL/issue/$issue/comment/$comment_id" > /dev/null
    echo "Comment deleted (id: $comment_id) from $issue"
    ;;

  api)
    method="${1:?Usage: jira api <METHOD> <path> [-q key=val] [-d json | -f file.json]}"
    path="${2:?Usage: jira api <METHOD> <path> [-q key=val] [-d json | -f file.json]}"
    shift 2
    method="${method^^}"
    path="${path#/}"
    url="$BASE_URL/$path"
    data=""
    data_file=""
    query_string=""
    curl_args=(-u "$AUTH" -H "Accept: application/json" -X "$method")
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -q|--query)
          kv="${2:?Missing query key=val after $1}"
          if [[ "$kv" != *=* ]]; then
            echo "Error: query must be key=val (got: $kv)" >&2
            exit 1
          fi
          qk="${kv%%=*}"
          qv="${kv#*=}"
          qk_enc=$(jq -rn --arg s "$qk" '$s|@uri')
          qv_enc=$(jq -rn --arg s "$qv" '$s|@uri')
          if [[ -n "$query_string" ]]; then
            query_string="${query_string}&${qk_enc}=${qv_enc}"
          else
            query_string="${qk_enc}=${qv_enc}"
          fi
          shift 2
          ;;
        -d|--data)
          data="${2:?Missing JSON payload after $1}"
          shift 2
          ;;
        -f|--file)
          data_file="${2:?Missing JSON file path after $1}"
          shift 2
          ;;
        *)
          echo "Usage: jira api <METHOD> <path> [-q key=val] [-d json | -f file.json]" >&2
          exit 1
          ;;
      esac
    done
    if [[ -n "$data" && -n "$data_file" ]]; then
      echo "Error: use either -d or -f, not both" >&2
      exit 1
    fi
    if [[ -n "$data_file" ]]; then
      data="$(cat "$data_file")"
    fi
    if [[ -n "$data" ]]; then
      curl_args+=(-H "Content-Type: application/json" -d "$data")
    fi
    if [[ -n "$query_string" ]]; then
      url="${url}?${query_string}"
    fi
    r=$(_curl "${curl_args[@]}" "$url")
    if echo "$r" | jq -e . >/dev/null 2>&1; then
      echo "$r" | jq .
    else
      echo "$r"
    fi
    ;;

  search|jql)
    jql_query="${1:?Usage: jira search <JQL>}"
    max="${2:-25}"
    r=$(_curl -u "$AUTH" -H "Accept: application/json" -G "$BASE_URL/search/jql" \
      --data-urlencode "jql=$jql_query" \
      --data-urlencode "maxResults=$max" \
      --data-urlencode "fields=summary,status,assignee,priority")
    if $JSON; then echo "$r" | jq .
    else
      count=$(echo "$r" | jq '.issues | length')
      if [[ "$count" == "0" ]]; then
        echo "(no matching issues — JQL: $jql_query)"
      else
        echo "$r" | _fmt_list
      fi
    fi
    ;;

  transition)
    issue="${1:?Usage: jira transition <ISSUE-KEY> <status-name>}"
    target="${2:-}"
    transitions=$(_curl -u "$AUTH" -H "Accept: application/json" "$BASE_URL/issue/$issue/transitions")
    if [[ -z "$target" ]]; then
      echo "Available transitions for $issue:"
      echo "$transitions" | jq -r '.transitions[] | "  " + .name'
      exit 0
    fi
    tid=$(echo "$transitions" | jq -r --arg n "$target" '.transitions[] | select(.name == $n) | .id')
    if [[ -z "$tid" ]]; then
      echo "Error: transition '$target' not found for $issue" >&2
      echo "Available transitions:"
      echo "$transitions" | jq -r '.transitions[] | "  " + .name' >&2
      exit 1
    fi
    _curl -u "$AUTH" \
      -H "Content-Type: application/json" \
      -X POST "$BASE_URL/issue/$issue/transitions" \
      -d "{\"transition\":{\"id\":\"$tid\"}}" > /dev/null
    echo "Transitioned $issue → $target"
    ;;

  changelog)
    issue="${1:?Usage: jira changelog <ISSUE-KEY> [maxResults] [--skip-system]}"
    shift
    max=25
    skip_system=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --skip-system)
          skip_system=true
          shift
          ;;
        *[!0-9]*)
          echo "Error: invalid maxResults '$1' (must be a number)" >&2
          echo "Usage: jira changelog <ISSUE-KEY> [maxResults] [--skip-system]" >&2
          exit 1
          ;;
        *)
          max="$1"
          shift
          ;;
      esac
    done
    r=$(_fetch_changelog_window "$issue" "$max")
    if $JSON; then echo "$r" | jq .
    else _fmt_changelog "$r" "$max" "$skip_system"; fi
    ;;

  history)
    issue="${1:?Usage: jira history <ISSUE-KEY> [maxChangelog] [maxComments] [--skip-system]}"
    shift
    max_changelog=10
    max_comments=5
    skip_system=false
    num_seen=0
    for arg in "$@"; do
      if [[ "$arg" == "--skip-system" ]]; then
        skip_system=true
      elif [[ "$arg" =~ ^[0-9]+$ ]]; then
        if (( num_seen == 0 )); then
          max_changelog="$arg"
        elif (( num_seen == 1 )); then
          max_comments="$arg"
        else
          echo "Usage: jira history <ISSUE-KEY> [maxChangelog] [maxComments] [--skip-system]" >&2
          exit 1
        fi
        num_seen=$((num_seen + 1))
      else
        echo "Usage: jira history <ISSUE-KEY> [maxChangelog] [maxComments] [--skip-system]" >&2
        exit 1
      fi
    done

    r_issue=$(_curl -u "$AUTH" -H "Accept: application/json" \
      "$BASE_URL/issue/$issue?fields=summary,status,assignee,priority,comment")
    r_changelog=$(_fetch_changelog_window "$issue" "$max_changelog")

    if $JSON; then
      jq -n --argjson issue "$r_issue" --argjson changelog "$r_changelog" \
        '{"issue":$issue,"changelog":$changelog}'
      exit 0
    fi

    echo "$r_issue" | _fmt_issue
    echo ""
    echo "── Changelog ──"
    _fmt_changelog "$r_changelog" "$max_changelog" "$skip_system"
    echo ""
    echo "── Recent comments ──"
    _fmt_comments "$(echo "$r_issue" | jq --argjson n "$max_comments" '
      {comments: ((.fields.comment.comments // []) as $c
        | if ($c | length) <= $n then $c else $c[(($c | length)-$n):] end)}')"
    ;;

  help|--help|-h)
    cat << 'EOF'
Usage: jira [--json] <command> [args...]

Commands:
  get <ISSUE-KEY> [-f f1,f2,...]    Issue (formatted header by default; with --json,
                                    pair -f to narrow the JSON payload to listed fields)
  describe <ISSUE-KEY>              Description as plain text (ADF rendered)
  comments <ISSUE-KEY>              All comments (author, date, text)
  show <ISSUE-KEY>                  Header + description + comments (ONE API call)
  comment <ISSUE-KEY> <text>        Add comment to issue (`[[KEY]]` creates linked issue card)
  comment-delete <ISSUE-KEY> <id>   Delete comment by id
  api <METHOD> <path> [...]         Generic REST wrapper under /rest/api/3/
  changelog <ISSUE-KEY> [n] [...]   Field change history (latest n entries, default 25)
  history <ISSUE-KEY> [...]         Header + changelog + recent comments (2 API calls)
  search <JQL> [maxResults]         Search issues with JQL (default: 25)
  jql <JQL> [maxResults]            Alias for search
  transition <ISSUE-KEY> [status]   Transition issue status (no status = list available)

Flags:
  --json    Output raw JSON instead of formatted text

Examples:
  jira show PROJ-123                       # everything in one call (token-efficient)
  jira get PROJ-123                        # just the header
  jira describe PROJ-123                   # description only
  jira comments PROJ-123                   # comments only
  jira comment PROJ-123 "Covers [[KNW-30718]] too"
  jira comment-delete PROJ-123 881685
  jira api GET issue/PROJ-123/changelog -q maxResults=20
  jira changelog PROJ-123 20 --skip-system
  jira history PROJ-123 10 5 --skip-system
  jira search "project=PROJ AND status=Open AND assignee=currentUser()"
  jira transition PROJ-123 "In Progress"
  jira transition PROJ-123                 # lists available transitions
  jira --json get PROJ-123 | jq .fields.status
  jira --json get PROJ-123 -f reporter,labels | jq '.fields'    # minimal payload

Credentials: ~/.config/jira/credentials
EOF
    ;;

  *)
    echo "Unknown command: $cmd" >&2
    echo "Run 'jira help' for usage" >&2
    exit 1
    ;;
esac
