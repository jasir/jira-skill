#!/usr/bin/env bash
# Thin launcher for jira.ts.
#
# `#!/usr/bin/env bun` on jira.ts is not enough: BUN_INSTALL is exported from
# ~/.bashrc, which non-interactive shells skip, so bun is missing from PATH in
# some agent contexts. Resolve it explicitly and fail with something actionable.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

BUN="$(command -v bun 2>/dev/null || true)"
if [[ -z "$BUN" ]]; then
  for candidate in "$HOME/.bun/bin/bun" "${BUN_INSTALL:-}/bin/bun" /usr/local/bin/bun; do
    if [[ -x "$candidate" ]]; then
      BUN="$candidate"
      break
    fi
  done
fi

if [[ -z "$BUN" ]]; then
  echo "Error: bun not found (needed to run jira.ts)." >&2
  echo "Install it with: curl -fsSL https://bun.sh/install | bash" >&2
  exit 127
fi

exec "$BUN" "$DIR/jira.ts" "$@"
